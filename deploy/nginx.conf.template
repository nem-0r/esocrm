# Реверс-прокси продакшена: TLS, редирект 80 → 443, статика фронтенда,
# проксирование REST и вебсокета.
#
# Файл монтируется в контейнер как /etc/nginx/templates/default.conf.template.
# Официальный образ nginx при старте прогоняет шаблоны через envsubst и кладёт
# результат в /etc/nginx/conf.d/. Подстановка ограничена переменной DOMAIN
# (NGINX_ENVSUBST_FILTER в docker-compose.prod.yml), поэтому $host, $scheme и
# прочие переменные самого nginx остаются нетронутыми.
#
# Готовый текст конфигурации можно посмотреть так:
#   docker compose -f docker-compose.prod.yml exec nginx cat /etc/nginx/conf.d/default.conf

# Заголовок Connection для проксируемых запросов: "upgrade" только тогда,
# когда клиент действительно просит переключить протокол. Слать "upgrade"
# всем подряд нельзя — обычные REST-ответы от этого ломаются на keep-alive.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream astra_api {
    server api:8000;
    keepalive 32;
}

upstream astra_web {
    server web:80;
    keepalive 16;
}

# Уведомления Робокассы (ResultURL) — единственный публичный, неавторизованный
# POST-эндпоинт в API. Плохая подпись отбивается быстро, но каждая попытка —
# это MD5 и обращение к базе; лимит защищает от перебора подписи и просто
# от шума. Настоящие уведомления Робокассы редки (одно на оплату), 5 req/s
# с запасом burst с одного адреса их не заденет.
limit_req_zone $binary_remote_addr zone=robokassa_result:10m rate=5r/s;

# Версия nginx в заголовке Server и на страницах ошибок — бесплатная подсказка
# тому, кто подбирает известные дыры под конкретный релиз.
server_tokens off;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types
    text/plain text/css text/xml text/javascript
    application/javascript application/json application/xml
    application/rss+xml image/svg+xml font/woff font/woff2;

# --- HTTP: только проверка сертификата и редирект на HTTPS ---
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Проверка владения доменом для Let's Encrypt. Должна оставаться доступной
    # по HTTP и НЕ редиректиться, иначе продление сертификата отвалится.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Проба живости самого nginx: контейнерный healthcheck ходит сюда,
    # редирект на https ему бы вернул 301 и вечный «unhealthy».
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS: рабочий контур ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Файлы клиентов: голосовые, фото, документы из переписки.
    client_max_body_size 50m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        default_type text/plain;
    }

    # Проба живости самого приложения — для внешнего мониторинга (uptime-робот,
    # Zabbix, «дежурный откройте ссылку»). Без этого правила /health попадал бы
    # в location / на фронтенд, тот на любой путь отдаёт index.html с кодом 200,
    # и мониторинг показывал бы «всё хорошо» при мёртвом API.
    # Отвечает {"status":"ok",...}; API лежит — 502.
    location = /health {
        access_log off;
        proxy_pass http://astra_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    10s;
    }

    # --- Вебсокет живых обновлений ---
    # Точное совпадение пути: этот location проверяется раньше префикса /api/,
    # порядок в файле роли не играет.
    location = /api/v1/ws {
        proxy_pass http://astra_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Соединение висит часами и молчит между событиями. Короткий таймаут
        # рвал бы его и заставлял интерфейс переподключаться каждую минуту.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # --- Уведомления Робокассы: свой лимит, до общего правила /api/ ---
    location = /api/v1/payments/robokassa/result {
        limit_req zone=robokassa_result burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://astra_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;
    }

    # --- REST API ---
    location /api/ {
        proxy_pass http://astra_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;

        # Ответы отдаём потоком: выгрузки и длинные списки не должны
        # копиться в буфере целиком.
        proxy_buffering off;
    }

    # Документация API наружу не нужна и подсказывает структуру системы.
    # Понадобится — снять комментарий и закрыть доступ по IP.
    location /docs   { return 404; }
    location /redoc  { return 404; }
    location /openapi.json { return 404; }

    # --- Статика фронтенда ---
    # Отдаёт контейнер web (nginx с собранным dist). Глубокие ссылки вида
    # /payments/1042 разворачиваются в index.html там же.
    location / {
        proxy_pass http://astra_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }
}
