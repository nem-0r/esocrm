# Окружение тестового стенда CI (docker-compose.ci.yml).
#
# Значения нарочно тестовые и лежат в репозитории: стенд живёт минуты, наружу
# не открыт, данные демо. Настоящих ключей здесь нет и быть не должно:
#  - Telegram не подключается (DEMO_MODE=true) — шлюз работает на демо-провайдере;
#  - Робокасса выключена (пароли пустые) — проверки не создают счетов в
#    настоящем магазине esoterra-pay (verify_robokassa в CI не запускается).
APP_ENV=local
DEMO_MODE=true
LOG_LEVEL=INFO

POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_ci_only
POSTGRES_DB=astra
DATABASE_URL=postgresql+asyncpg://astra:astra_ci_only@db:5432/astra
REDIS_URL=redis://cache:6379/0

S3_ENDPOINT_URL=http://storage:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=astra_ci_access
S3_SECRET_KEY=astra_ci_secret_0123456789
S3_BUCKET=astra-files
S3_REGION=us-east-1

SECRET_KEY=ci_only_secret_key_not_for_production_0123456789abcdef
ENCRYPTION_KEY=ci_only_encryption_key_not_for_production_0123456789ab
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
