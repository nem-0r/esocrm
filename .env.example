# =============================================================================
#  Астра CRM — заготовка переменных окружения
# =============================================================================
#  Локальная работа:   cp .env.example .env  &&  make up
#  Продакшен:          cp .env.example .env  и заменить ВСЕ значения CHANGE_ME_*
#
#  Значения CHANGE_ME_* — заглушки. Локально они работают (это учётные данные
#  контейнеров, поднимаемых с нуля на вашей же машине), в продакшене — нет:
#  при APP_ENV=production приложение откажется стартовать на них и напишет,
#  что именно поправить.
#
#  Осторожно: если база уже создана, менять POSTGRES_PASSWORD в .env бесполезно —
#  пароль записан внутрь тома pgdata при первом запуске. Либо меняйте пароль
#  внутри базы (ALTER USER), либо пересоздавайте том.
#
#  Этот файл лежит в репозитории. Заполненный .env — НЕ лежит (он в .gitignore).
#  Не коммитьте настоящие ключи.
# =============================================================================

# --- режим ---
# local | development | production
APP_ENV=local
# true = шлюз НЕ подключается к Telegram, работаем на демо-данных.
# В продакшене обязательно false.
DEMO_MODE=true
LOG_LEVEL=INFO

# --- домен (нужен только продакшену) ---
# Имя сайта без схемы и без слэша. Под него выпускается сертификат
# и на него настраивается nginx. Например: crm.example.ru
DOMAIN=

# --- база ---
POSTGRES_USER=astra
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=astra
# Пароль здесь обязан совпадать с POSTGRES_PASSWORD выше.
DATABASE_URL=postgresql+asyncpg://astra:CHANGE_ME_postgres_password@db:5432/astra

# Пул соединений с базой. Для api и scheduler — размер НА процесс (он всегда
# один). Для gateway — общий бюджет на контейнер: app/core/db.py сам делит
# его на число процессов шлюза, которое контейнер поднимет (растёт с числом
# ядер сервера). Апгрейд сервера — больше ядер, больше процессов шлюза —
# не требует трогать эти числа: бюджет остаётся прежним, просто иначе
# делится, вместо того чтобы незаметно умножаться на N. Пусто = 10 / 20.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- redis ---
REDIS_URL=redis://cache:6379/0

# --- хранилище файлов (MinIO) ---
S3_ENDPOINT_URL=http://storage:9000
# Адрес консоли MinIO для человека. Браузер клиента сюда не ходит: вложения
# отдаёт сам API (/api/v1/files/...), прямых ссылок в хранилище нет — поэтому
# в продакшене порты MinIO наружу не публикуются.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME_minio_access_key
S3_SECRET_KEY=CHANGE_ME_minio_secret_key
S3_BUCKET=astra-files
S3_REGION=us-east-1

# --- шлюз Telegram ---
# Сколько аккаунтов один процесс шлюза готов арендовать разом (docs/07-architecture.md
# §2) — предел НА ОДИН процесс, не суммарно. Пусто = по умолчанию 25.
# Каждый процесс вдобавок сам придерживает рост при нагрузке хоста (app/gateway/load.py) —
# и по CPU, и по памяти.
#
# Число процессов больше не фиксируется в docker-compose — контейнер gateway сам
# поднимает по одному процессу на каждое видимое ему ядро минус одно (резерв под
# служебные задачи), см. app/gateway/topology.py. На 4-ядерном сервере это 3 процесса,
# на 8-ядерном — 7, и так далее автоматически при каждом перезапуске: поменяли
# конфигурацию сервера — просто перезапустили контейнер, ничего не пересчитывая руками.
#
# Если процесс падает, супервизор поднимает новый вместо него за ~5 секунд
# (app/gateway/worker.py) — это не постоянная потеря мощности, а короткая просадка,
# так что закладывать двойной запас на «выживших после отказа», как раньше, не нужно.
# Подбирайте так, чтобы суммарно процессы покрывали все подключённые аккаунты:
# (число процессов) × GATEWAY_CAPACITY ≥ цель. Число процессов на сервере видно
# в логе шлюза при старте («Поднимаю N процессов шлюза») или через
# docker compose exec gateway python -c "from app.gateway import topology; print(topology.worker_count())".
GATEWAY_CAPACITY=15

# --- Telegram ---
# Ключи приложения выдаёт my.telegram.org. Они общие для всех подключаемых
# аккаунтов: руководитель в интерфейсе вводит только название, номер и этап.
# В демо-режиме не нужны.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Выход в сеть для MTProto. Пусто — подключаться напрямую с адреса сервера.
# Формат: socks5://user:pass@host:port  (поддерживается и http://)
# Прокси нужен, когда аккаунты живут в стране, чей адрес отличается от адреса
# сервера: резкая смена страны входа — типовая причина блокировки номера.
TELEGRAM_PROXY=

# --- безопасность ---
# SECRET_KEY подписывает сессии, ENCRYPTION_KEY шифрует сессии Telegram и api_hash.
# Два РАЗНЫХ значения, каждое генерируется отдельно:
#     openssl rand -hex 32
# Смена SECRET_KEY разлогинит всех. Смена ENCRYPTION_KEY сделает нечитаемыми
# уже сохранённые сессии Telegram — их придётся подключать заново.
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_hex_32_other
SESSION_TTL_DAYS=30
# true = cookie сессии уходит только по HTTPS. В продакшене обязательно true.
COOKIE_SECURE=false

# --- Робокасса ---
# Магазин, Пароль #1 и Пароль #2 выдаёт Робокасса при регистрации магазина —
# получить их у Богдана. Пусто = приём оплаты по ссылке отключён (в форме
# счёта останутся только «Реквизиты», кнопка «Ссылка» будет неактивна).
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# true = тестовый магазин Робокассы, платежи ненастоящие (IsTest=1 в ссылке).
# В продакшене с боевыми паролями обязательно false.
ROBOKASSA_IS_TEST=true
#
# Дополнительно, ОДИН РАЗ и НЕ здесь: в личном кабинете Робокассы
# (Настройки → Технические настройки) указать три адреса:
#   Result URL:  https://<DOMAIN>/api/v1/payments/robokassa/result  — метод POST
#   Success URL: https://<DOMAIN>/pay/success                        — GET (переход браузера)
#   Fail URL:    https://<DOMAIN>/pay/fail                           — GET (переход браузера)
# Без этого шага Робокасса не будет знать, куда слать уведомление об оплате
# и куда возвращать клиента — сама по себе переменная DOMAIN этого не делает.

# --- фронтенд ---
# Используется только контуром разработки (vite проксирует /api сюда).
# В продакшене фронтенд ходит по относительному пути через nginx.
VITE_API_URL=http://localhost:8000
# Источники, которым разрешены запросы с cookie.
# Продакшен: https://<DOMAIN>
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
